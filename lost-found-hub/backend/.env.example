# ==========================================
# Lost & Found Hub - Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file to version control.
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local example:      mongodb://127.0.0.1:27017/lostfoundhub
# Atlas example:       mongodb+srv://<user>:<password>@cluster0.mongodb.net/lostfoundhub?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/lostfoundhub

# Frontend origin allowed to call this API (CORS). Use * only for local dev.
CLIENT_ORIGIN=http://localhost:5000

# OpenRouter API (for "Magesh AI" chatbot)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional, used by OpenRouter for attribution/rate-limit headers
SITE_URL=http://localhost:5000
SITE_NAME=Lost & Found Hub
